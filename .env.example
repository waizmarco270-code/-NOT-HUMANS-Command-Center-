# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLASH_API_KEY: Required for secure requests to the Official Clash of Clans Developer API.
CLASH_API_KEY=

# CLASH_API_BASE_URL: Optional API proxy address to bypass Vercel dynamic serverless IPs (e.g. https://cocproxy.royaleapi.dev/v1)
CLASH_API_BASE_URL=

# Firebase Client Overrides (VITE_ prefixed for browser client compilation)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
